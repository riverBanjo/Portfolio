---
import Layout from "../layouts/Layout.astro";
import { socials } from "../data/site";
---

<Layout title="Contact" description="Get in touch with River Fisher.">
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-24">
    <h1 class="mb-6 text-3xl font-medium tracking-tight text-(--color-ink)">
      Contact
    </h1>
    <p class="mb-8 max-w-xl text-(--color-ink-dim)">
      I'm looking for an engineering role on a team that
      ships. If that's you, I'd love to talk.
    </p>

    <ul class="flex gap-6 font-mono text-sm">
      {
        socials.map((link) => (
          <li>
            <a
              href={link.href}
              target="_blank"
              rel="noreferrer"
              class="text-(--color-ink-dim) transition-colors hover:text-(--color-accent)"
            >
              {link.label} &nearr;
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
