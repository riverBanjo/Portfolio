---
const links = [
  { href: "/", label: "Home" },
  { href: "/projects", label: "Projects" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header class="border-b border-(--color-line)">
  <nav class="mx-auto flex max-w-3xl items-center justify-between px-6 py-5">
    <a href="/" class="font-mono text-sm tracking-tight text-(--color-ink)">
      river<span class="text-(--color-accent)">.</span>fisher
    </a>
    <ul class="flex gap-6 font-mono text-sm">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                "transition-colors hover:text-(--color-accent)",
                isActive(link.href)
                  ? "text-(--color-accent)"
                  : "text-(--color-ink-dim)",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
